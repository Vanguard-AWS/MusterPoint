@page "/register"
@using MusterPoint.Client.Models.Authentication
@using MusterPoint.Client.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<PageTitle>Register - MusterPoint</PageTitle>

@if (isCheckingAuth)
{
    <div class="terminal-container loading-screen">
 <div class="scanlines"></div>
        <div class="terminal-content">
  <p class="terminal-text">[INITIALIZING SYSTEM...]</p>
   <div class="loading-spinner-terminal"></div>
      <p class="terminal-text">[LOADING REGISTRATION PROTOCOL...]</p>
    </div>
    </div>
}
else
{
  <div class="terminal-container">
        <div class="scanlines"></div>
<div class="terminal-content register-content">
    <div class="ascii-header">
        <h1 class="title-main">CREATE PROFILE</h1>
    <p class="title-sub">User Registration Protocol</p>
  </div>

       @if (!string.IsNullOrEmpty(errorMessage))
   {
    <div class="terminal-alert alert-danger">
           <p class="terminal-text">
    <span class="alert-icon">?</span> @errorMessage
         </p>
    </div>
  }

   @if (!string.IsNullOrEmpty(successMessage))
      {
 <div class="terminal-alert alert-success">
   <p class="terminal-text">
      <span class="alert-icon">?</span> @successMessage
           </p>
       </div>
     }

    <form @onsubmit="HandleRegister">
     <div class="form-row">
   <div class="form-column">
      <div class="terminal-section form-group">
     <label class="terminal-text terminal-prompt">> USERNAME</label>
   <input type="text" class="terminal-input" id="username" @bind="username" required placeholder="Choose a username" />
       </div>
    </div>

    <div class="form-column">
      <div class="terminal-section form-group">
 <label class="terminal-text terminal-prompt">> EMAIL</label>
        <input type="email" class="terminal-input" id="email" @bind="email" required placeholder="your@email.com" />
  </div>
    </div>
  </div>

    <div class="form-row">
   <div class="form-column">
     <div class="terminal-section form-group">
  <label class="terminal-text terminal-prompt">> PASSWORD</label>
   <input type="password" class="terminal-input" id="password" @bind="password" required placeholder="At least 8 characters" />
   <p class="terminal-text terminal-dim" style="margin-top: 0.5rem; font-size: 0.8rem;">[ Minimum 8 characters required ]</p>
    </div>
   </div>

    <div class="form-column">
      <div class="terminal-section form-group">
  <label class="terminal-text terminal-prompt">> CONFIRM PASSWORD</label>
        <input type="password" class="terminal-input" id="confirmPassword" @bind="confirmPassword" required placeholder="Re-enter your password" />
    </div>
   </div>
  </div>

  <div class="terminal-section button-group">
     <button type="submit" class="terminal-button terminal-button-primary" disabled="@isLoading">
       <span class="button-bracket">[</span>
    <span class="button-text">
        @if (isLoading)
 {
   <span>CREATING ACCOUNT...</span>
}
         else
   {
    <span>REGISTER</span>
    }
  </span>
        <span class="button-bracket">]</span>
    </button>
    </div>
  </form>

  <div class="terminal-section footer">
      <p class="terminal-text terminal-dim">
 > Already registered? <a href="/login" class="terminal-link">SIGN IN</a>
 </p>
  </div>
   </div>
 </div>
}

@code {
    private string username = string.Empty;
 private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;
 private string successMessage = string.Empty;
    private bool isLoading = false;
    private bool isCheckingAuth = true;

    protected override async Task OnInitializedAsync()
    {
   isCheckingAuth = true;
     try
   {
     var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
     {
    NavigationManager.NavigateTo("/lists", replace: true);
     return;
   }
    }
    catch (Exception ex)
      {
 errorMessage = $"Error checking authentication: {ex.Message}";
    }
   finally
     {
   isCheckingAuth = false;
       }
    }

   private async Task HandleRegister()
{
  if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) ||
  string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirmPassword))
 {
      errorMessage = "All fields are required";
        return;
    }

   if (password != confirmPassword)
{
     errorMessage = "Passwords do not match";
       return;
   }

      if (password.Length < 8)
       {
  errorMessage = "Password must be at least 8 characters";
         return;
      }

      isLoading = true;

     try
      {
      var response = await AuthService.RegisterAsync(username, email, password, confirmPassword);

        if (response.Success)
     {
 successMessage = "Registration successful! Redirecting to login...";
  await Task.Delay(2000);
   NavigationManager.NavigateTo("/login");
         }
   else
  {
    errorMessage = response.Message;
   }
     }
    catch (Exception ex)
   {
     errorMessage = $"An error occurred: {ex.Message}";
       }
   finally
{
       isLoading = false;
    }
   }
}
