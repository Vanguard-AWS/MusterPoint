@namespace MusterPoint.Client.Pages
@using MusterPoint.Client.Models

<!-- Modal Overlay -->
<div class="modal @(IsOpen ? "is-active" : "")">
    <div class="modal-background" @onclick="OnClose"></div>
    <div class="modal-card unit-details-modal">
        <header class="modal-card-head">
 <p class="modal-card-title">@SelectedUnit?.Name</p>
        </header>
        <section class="modal-card-body">
    @if (SelectedUnit != null)
        {
        <!-- Unit Header Info -->
       <div class="section-box">
         <div class="info-grid">
       <div class="info-item">
   <span class="info-label">Category</span>
    <span class="info-value">@(SelectedUnit.Category ?? "N/A")</span>
   </div>
       <div class="info-item">
 <span class="info-label">Points (Min)</span>
           <span class="info-value">@SelectedUnit.BasePoints PTS</span>
</div>
     <div class="info-item">
         <span class="info-label">Squad Size</span>
        <span class="info-value">@SelectedUnit.MinSize-@SelectedUnit.MaxSize MODELS</span>
  </div>
    </div>

           <!-- Keywords -->
             @if (SelectedUnit.Keywords.Any())
    {
      <div class="mt-4">
      <p class="info-label mb-2">KEYWORDS</p>
   <div class="tags">
  @foreach (var keyword in SelectedUnit.Keywords)
      {
      <span class="terminal-tag keyword-tag">@keyword</span>
         }
     </div>
       </div>
          }

         <!-- Faction Keywords -->
        @if (SelectedUnit.FactionKeywords.Any())
  {
         <div class="mt-3">
         <p class="info-label mb-2">FACTION</p>
         <div class="tags">
          @foreach (var keyword in SelectedUnit.FactionKeywords)
        {
            <span class="terminal-tag faction-tag">@keyword</span>
        }
            </div>
 </div>
    }
     </div>

       <!-- Enhancements Section (Characters only) -->
    @if (IsCharacter && AvailableEnhancements.Any())
 {
  <div class="section-box enhancement-section">
    <h3 class="section-title">ENHANCEMENTS</h3>
    <div class="enhancement-dropdown-container">
     <label class="enhancement-label">SELECT ENHANCEMENT:</label>
      <select class="enhancement-select" @bind="_selectedEnhancementId" @bind:after="OnEnhancementBindChanged">
  <option value="">-- None --</option>
     @foreach (var enhancement in AvailableEnhancements)
        {
  <option value="@enhancement.Id">@enhancement.Name (+@enhancement.Points PTS)</option>
 }
        </select>
    </div>
    
    @if (!string.IsNullOrEmpty(_selectedEnhancementId))
    {
  var selectedEnhance = AvailableEnhancements.FirstOrDefault(e => e.Id == _selectedEnhancementId);
        if (selectedEnhance != null)
        {
     <div class="enhancement-selected mt-3">
 <p class="is-size-7 terminal-text" style="color: var(--terminal-green);"><i class="fas fa-check-circle mr-2"></i>ENHANCEMENT SELECTED</p>
  <div class="mt-2">
  <span class="enhancement-name">@selectedEnhance.Name <span class="enhancement-cost">+@selectedEnhance.Points PTS</span></span>
     <p class="enhancement-desc mt-2">@selectedEnhance.Description</p>
     </div>
<button class="terminal-button is-small is-danger mt-3" @onclick="ClearEnhancement">
[ REMOVE ENHANCEMENT ]
     </button>
      </div>
        }
        else
        {
            <p style="color: red;">ERROR: Could not find enhancement with ID "@_selectedEnhancementId" in AvailableEnhancements</p>
      }
    }
  </div>
    }
    else if (IsCharacter)
    {
        <div class="section-box" style="border-color: orange;">
        <p style="color: orange;">Enhancement section hidden - AvailableEnhancements.Count = @AvailableEnhancements.Count</p>
        </div>
    }

    <!-- Warlord Section (Characters only) -->
 @if (IsCharacter)
    {
<div class="section-box warlord-section">
     <h3 class="section-title">WARLORD</h3>
     <label class="warlord-checkbox">
<input type="checkbox" @onchange="HandleWarlordToggle" checked="@IsWarlordSelected" />
 <span class="ml-2">[ SET AS WARLORD ]</span>
   </label>
 @if (IsWarlordSelected)
    {
      <p class="is-size-7 terminal-text mt-2" style="color: var(--terminal-orange);"><i class="fas fa-crown mr-2"></i>THIS CHARACTER IS YOUR WARLORD</p>
   }
   </div>
    }

    <!-- Unit Composition -->
   @if (SelectedUnit.UnitComposition.Any())
      {
      <div class="section-box">
       <h3 class="section-title">UNIT COMPOSITION</h3>
           <table class="terminal-table">
 <tbody>
   @foreach (var role in SelectedUnit.UnitComposition)
       {
  <tr>
  <td>@role.Role</td>
      <td class="has-text-right"><strong>@role.Count</strong></td>
        </tr>
        }
   </tbody>
             </table>
     </div>
                }

   <!-- Profiles (Stats) -->
           @if (SelectedUnit.Profiles.Any())
        {
<div class="section-box">
       <h3 class="section-title">MODEL PROFILES</h3>
           @foreach (var profile in SelectedUnit.Profiles)
            {
    <div class="mb-3">
     <p class="terminal-prompt mb-1">@profile.Name</p>
           <table class="terminal-table">
         <thead>
             <tr>
          <th>M</th>
  <th>T</th>
      <th>Sv</th>
          <th>W</th>
    <th>Ld</th>
       <th>OC</th>
          </tr>
         </thead>
         <tbody>
           <tr>
                  <td>@profile.Movement</td>
          <td>@profile.Toughness</td>
        <td>@profile.Save</td>
       <td>@profile.Wounds</td>
      <td>@profile.Leadership</td>
        <td>@profile.ObjectiveControl</td>
         </tr>
   </tbody>
       </table>
    </div>
              }
  </div>
   }

           <!-- Ranged Weapons -->
     @if (SelectedUnit.RangedWeapons.Any())
         {
        <div class="section-box">
       <h3 class="section-title">RANGED WEAPONS</h3>
                @foreach (var weapon in SelectedUnit.RangedWeapons)
      {
              <div class="weapon-profile">
    <span class="weapon-name">@weapon.Name</span>
             <table class="terminal-table">
   <thead>
    <tr>
           <th>RANGE</th>
        <th>A</th>
        <th>BS</th>
         <th>S</th>
       <th>AP</th>
           <th>D</th>
           <th>TYPE</th>
             </tr>
         </thead>
         <tbody>
          <tr>
      <td>@weapon.Range</td>
             <td>@weapon.Attacks</td>
             <td>@weapon.BallisticSkill</td>
<td>@weapon.Strength</td>
   <td>@weapon.ArmorPenetration</td>
                <td>@weapon.Damage</td>
         <td><span class="terminal-dim">@weapon.Type</span></td>
     </tr>
      </tbody>
          </table>
           @if (!string.IsNullOrEmpty(weapon.Special))
            {
         <p class="weapon-special">SPECIAL: @weapon.Special</p>
      }
           </div>
          }
      </div>
      }

     <!-- Melee Weapons -->
         @if (SelectedUnit.MeleeWeapons.Any())
                {
      <div class="section-box">
             <h3 class="section-title">MELEE WEAPONS</h3>
          @foreach (var weapon in SelectedUnit.MeleeWeapons)
      {
  <div class="weapon-profile">
       <span class="weapon-name">@weapon.Name</span>
 <table class="terminal-table">
    <thead>
      <tr>
     <th>A</th>
          <th>WS</th>
   <th>S</th>
     <th>AP</th>
   <th>D</th>
    </tr>
     </thead>
                <tbody>
  <tr>
           <td>@weapon.Attacks</td>
         <td>@weapon.WeaponSkill</td>
           <td>@weapon.Strength</td>
     <td>@weapon.ArmorPenetration</td>
              <td>@weapon.Damage</td>
     </tr>
     </tbody>
         </table>
              @if (!string.IsNullOrEmpty(weapon.Special))
        {
           <p class="weapon-special">SPECIAL: @weapon.Special</p>
      }
               </div>
        }
              </div>
}

  <!-- Abilities -->
      @if (SelectedUnit.Abilities.Any())
                {
                 <div class="section-box">
       <h3 class="section-title">ABILITIES</h3>
@foreach (var ability in SelectedUnit.Abilities)
      {
   <div class="mb-3 pb-3" style="border-bottom: 1px dashed rgba(0, 255, 65, 0.3);">
   <p class="terminal-prompt">
           @ability.Name
          <span class="terminal-tag ml-2 @(ability.Type == "faction" ? "faction-tag" : "keyword-tag")">@ability.Type</span>
       </p>
       <p class="terminal-text is-size-7">@ability.Description</p>
            </div>
            }
         </div>
     }

              <!-- Wargear Options -->
    @if (SelectedUnit.WargearOptions.Any())
     {
               <div class="section-box">
  <h3 class="section-title">WARGEAR OPTIONS</h3>
             @foreach (var option in SelectedUnit.WargearOptions)
         {
       <div class="mb-4 pb-3" style="border-bottom: 1px dashed rgba(0, 255, 65, 0.3);">
   <p class="terminal-prompt">@option.Name</p>
       <p class="terminal-text is-size-7 mb-2">@option.Description</p>
            <div class="tags">
      @foreach (var choice in option.Options)
    {
             <span class="terminal-tag">@choice</span>
     }
    </div>
   @if (!string.IsNullOrEmpty(option.SelectionLimit))
      {
        <p class="terminal-dim is-size-7 mt-1">LIMIT: @option.SelectionLimit</p>
              }
 @if (option.PointsCost > 0)
     {
                <p class="terminal-dim is-size-7">+@option.PointsCost PTS</p>
        }
  </div>
      }
         </div>
      }
            }
        </section>
        <footer class="modal-card-foot">
  <button class="terminal-button" @onclick="OnClose">[ CLOSE ]</button>
        </footer>
    </div>
</div>

@code {
    [Parameter]
    public Unit? SelectedUnit { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
  public string? InitialEnhancementId { get; set; }

    [Parameter]
    public bool InitialWarlordState { get; set; } = false;

    [Parameter]
    public Detachment? SelectedDetachment { get; set; }

    [Parameter]
    public EventCallback<(string enhancementId, string enhancementName, int enhancementPoints, string enhancementDescription)> OnEnhancementSelected { get; set; }

    [Parameter]
    public EventCallback<bool> OnWarlordSelected { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

 private List<Enhancement> AvailableEnhancements => SelectedDetachment?.Enhancements ?? new();
    private string _selectedEnhancementId = string.Empty;
    private bool IsWarlordSelected { get; set; } = false;
    
    private bool IsCharacter => SelectedUnit?.Category == "Characters";

    protected override void OnParametersSet()
    {
 // Load initial state from parameters when modal opens
  if (IsOpen)
        {
            _selectedEnhancementId = InitialEnhancementId ?? string.Empty;
    IsWarlordSelected = InitialWarlordState;
        }
    }

    private async Task HandleWarlordToggle(ChangeEventArgs e)
    {
        IsWarlordSelected = (bool)(e.Value ?? false);
        await OnWarlordSelected.InvokeAsync(IsWarlordSelected);
    }

    private async Task OnEnhancementBindChanged()
    {
        if (!string.IsNullOrEmpty(_selectedEnhancementId))
        {
         var selectedEnhance = AvailableEnhancements.FirstOrDefault(en => en.Id == _selectedEnhancementId);
            if (selectedEnhance != null)
        {
await OnEnhancementSelected.InvokeAsync((_selectedEnhancementId, selectedEnhance.Name, selectedEnhance.Points, selectedEnhance.Description));
  }
        }
     else
        {
  await OnEnhancementSelected.InvokeAsync((string.Empty, string.Empty, 0, string.Empty));
 }
    }

    private async Task ClearEnhancement()
    {
    _selectedEnhancementId = string.Empty;
        await OnEnhancementSelected.InvokeAsync((string.Empty, string.Empty, 0, string.Empty));
    }
}
