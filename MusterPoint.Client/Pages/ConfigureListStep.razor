@namespace MusterPoint.Client.Pages
@using MusterPoint.Client.Models
@using MusterPoint.Client.Services
@inject DetachmentService DetachmentService
@rendermode InteractiveWebAssembly

<div class="configure-list-container">
    <div class="configure-header">
  <h1 class="title-main">CONFIGURE LIST</h1>
  <p class="title-sub">Customize Your Roster</p>
    </div>

 <div class="configure-box terminal-panel">
 <div class="form-group">
    <p class="terminal-text">
     <span class="config-label">FACTION:</span>
     <span class="info-badge">@SelectedFaction</span>
    </p>
 </div>

   <div class="form-group">
  <label class="terminal-text terminal-prompt">> LIST NAME</label>
      <input type="text" class="terminal-input" @bind="localListName" @bind:event="oninput" />
    </div>

   <div class="form-group">
  <label class="terminal-text terminal-prompt">> DETACHMENT</label>
   @if (isLoadingDetachments)
    {
      <p class="terminal-text">[LOADING DETACHMENTS...]</p>
  }
    else if (availableDetachments == null || !availableDetachments.Any())
     {
   <p class="terminal-text">[NO DETACHMENTS AVAILABLE]</p>
        }
      else
  {
  <select class="terminal-select" @bind="localSelectedDetachment">
     <option value="">Select a Detachment</option>
   @foreach (var detachment in availableDetachments)
 {
        <option value="@detachment.Id">@detachment.Name</option>
   }
  </select>
   }
   </div>

  <div class="form-group">
  <label class="terminal-text terminal-prompt">> FORCE SIZE</label>
   <div class="game-size-options">
        <button class="game-size-button @(localGameSize == 500 ? "is-selected" : "")" @onclick="() => SelectGameSize(500)">
   <span class="size-name">Combat Patrol</span>
  <span class="size-points">500 PTS</span>
  </button>
     <button class="game-size-button @(localGameSize == 1000 ? "is-selected" : "")" @onclick="() => SelectGameSize(1000)">
 <span class="size-name">Incursion</span>
  <span class="size-points">1000 PTS</span>
  </button>
     <button class="game-size-button @(localGameSize == 2000 ? "is-selected" : "")" @onclick="() => SelectGameSize(2000)">
   <span class="size-name">Strike Force</span>
<span class="size-points">2000 PTS</span>
  </button>
   <button class="game-size-button @(localGameSize == 3000 ? "is-selected" : "")" @onclick="() => SelectGameSize(3000)">
<span class="size-name">Onslaught</span>
<span class="size-points">3000 PTS</span>
 </button>
      </div>
 </div>
   </div>

    <div class="configure-actions">
  <button class="terminal-button terminal-button-secondary" @onclick="HandleBack">
 <span class="button-bracket">[</span>
       <span class="button-text">BACK</span>
<span class="button-bracket">]</span>
</button>
  <button class="terminal-button terminal-button-primary" disabled="@(string.IsNullOrWhiteSpace(localListName) || string.IsNullOrWhiteSpace(localSelectedDetachment))" @onclick="HandleContinue">
 <span class="button-bracket">[</span>
    <span class="button-text">CONTINUE</span>
      <span class="button-bracket">]</span>
</button>
   </div>
</div>

@code {
    [Parameter]
  public string SelectedFaction { get; set; } = string.Empty;

    [Parameter]
    public string ListName { get; set; } = string.Empty;

 [Parameter]
    public string SelectedDetachment { get; set; } = string.Empty;

   [Parameter]
  public int SelectedGameSize { get; set; } = 2000;

    [Parameter]
  public EventCallback<string> OnListNameChanged { get; set; }

 [Parameter]
  public EventCallback<string> OnDetachmentChanged { get; set; }

 [Parameter]
    public EventCallback<int> OnGameSizeChanged { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

 [Parameter]
    public EventCallback OnContinue { get; set; }

    private List<Detachment> availableDetachments = new();
  private bool isLoadingDetachments = false;
    
    // Local fields to prevent binding issues during re-renders
    private string localListName = string.Empty;
    private string localSelectedDetachment = string.Empty;
    private int localGameSize = 2000;

    protected override async Task OnInitializedAsync()
   {
  await LoadDetachments();
  }

    protected override void OnParametersSet()
    {
        // Sync parameter values to local fields
        localListName = ListName;
        localSelectedDetachment = SelectedDetachment;
      localGameSize = SelectedGameSize;
    }

    private async Task LoadDetachments()
    {
    try
   {
isLoadingDetachments = true;
   availableDetachments = await DetachmentService.GetDetachmentsByFactionAsync(SelectedFaction);
}
        catch (Exception ex)
    {
     Console.WriteLine($"Error loading detachments: {ex.Message}");
    }
    finally
 {
  isLoadingDetachments = false;
  }
 }

    private async Task HandleBack()
    {
  await OnBack.InvokeAsync();
    }

    private void SelectGameSize(int size)
    {
    localGameSize = size;
    }

  private async Task HandleContinue()
  {
  await OnListNameChanged.InvokeAsync(localListName);
    await OnDetachmentChanged.InvokeAsync(localSelectedDetachment);
    await OnGameSizeChanged.InvokeAsync(localGameSize);
    await OnContinue.InvokeAsync();
    }
}
