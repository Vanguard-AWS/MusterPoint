@page "/lists"
@using MusterPoint.Client.Models
@using MusterPoint.Client.Services
@using MusterPoint.Client.Components
@inject ListStorageService ListStorageService
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<PageTitle>My Lists - MusterPoint</PageTitle>

<div class="lists-container">
    <div class="level mb-6">
        <div class="level-left">
            <h1 class="title is-2">My Lists</h1>
      </div>
        <div class="level-right">
     <a href="/listbuilder" class="button is-primary">
         <span class="icon">
      <i class="fas fa-plus"></i>
                </span>
    <span>New List</span>
      </a>
   <SignOutButton />
        </div>
    </div>

    @if (isLoading)
    {
   <div class="box">
            <p class="has-text-grey"><em>Loading your lists...</em></p>
     </div>
    }
    else if (userLists == null || !userLists.Any())
    {
   <div class="box">
         <p class="has-text-grey has-text-centered py-5">
      You don't have any lists yet. <a href="/listbuilder" class="has-text-primary">Create one now</a>!
         </p>
        </div>
    }
    else
    {
    <div class="lists-grid">
            @foreach (var list in userLists)
 {
          <div class="box list-card">
   <div class="level is-mobile">
        <div class="level-left">
   <div>
   <h2 class="title is-4 mb-2">@list.Name</h2>
       <p class="has-text-grey">
  <span class="tag is-light">@list.Faction</span>
     <span class="tag is-info ml-2">@list.Entries.Select(e => e.UnitId).Distinct().Count() unique units</span>
 <span class="tag is-success ml-2">@list.CalculateTotalPoints() pts</span>
      </p>
  </div>
      </div>
  </div>

    <div class="buttons mt-4">
         <a href="/list/@list.Id" class="button is-info is-small">
         <span class="icon">
 <i class="fas fa-eye"></i>
     </span>
    <span>View Details</span>
   </a>
           <a href="/listbuilder/@list.Id" class="button is-primary is-small">
         <span class="icon">
<i class="fas fa-edit"></i>
     </span>
      <span>Edit</span>
     </a>
<button class="button is-danger is-small" @onclick="() => DeleteList(list.Id)">
  <span class="icon">
    <i class="fas fa-trash"></i>
        </span>
     <span>Delete</span>
     </button>
    </div>
        </div>
            }
    </div>
    }
</div>

@code {
  private List<UserList>? userLists;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadLists();
    }

    private async Task LoadLists()
    {
 try
      {
          isLoading = true;
     userLists = await ListStorageService.GetAllListsAsync();
     }
   catch (Exception ex)
        {
   Console.WriteLine($"Error loading lists: {ex.Message}");
      userLists = new();
    }
      finally
        {
  isLoading = false;
        }
    }

    private async Task DeleteList(string listId)
    {
        try
      {
    await ListStorageService.DeleteListAsync(listId);
      await LoadLists();
        }
        catch (Exception ex)
    {
            Console.WriteLine($"Error deleting list: {ex.Message}");
        }
    }
}
