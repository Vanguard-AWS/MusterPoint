@page "/lists"
@using MusterPoint.Client.Models
@using MusterPoint.Client.Services
@using MusterPoint.Client.Components
@inject ListStorageService ListStorageService
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<PageTitle>My Lists - MusterPoint</PageTitle>

<div class="lists-container">
    <div class="lists-header">
    <div class="header-left">
       <h1 class="title-main">MY LISTS</h1>
      <p class="title-sub">Manage Your Army Rosters</p>
        </div>
        <div class="header-right">
     <a href="/listbuilder" class="terminal-button terminal-button-secondary">
   <span class="button-bracket">[</span>
       <span class="button-text">+ NEW LIST</span>
   <span class="button-bracket">]</span>
     </a>
   <SignOutButton />
 </div>
    </div>

  @if (isLoading)
    {
      <div class="terminal-panel loading-panel">
     <p class="terminal-text">[LOADING ROSTER DATABASE...]</p>
   <div class="loading-spinner-terminal"></div>
        </div>
    }
    else if (userLists == null || !userLists.Any())
    {
        <div class="terminal-panel empty-panel">
<p class="terminal-text">
  [NO ROSTERS FOUND]<br/>
           <a href="/listbuilder" class="terminal-link">CREATE YOUR FIRST ROSTER</a>
   </p>
   </div>
    }
    else
    {
     <div class="lists-grid">
@foreach (var list in userLists)
          {
   <div class="list-card terminal-panel">
        <div class="card-header">
        <h2 class="card-title terminal-prompt">@list.Name</h2>
              </div>

       <div class="card-info">
      <p class="terminal-text terminal-dim">
       <span class="info-badge">@list.Faction</span>
   @if (!string.IsNullOrEmpty(list.Detachment))
         {
   <span class="info-badge">@list.Detachment</span>
         }
           <span class="info-badge">@list.CalculateTotalPoints() PTS</span>
     </p>
             </div>

     <div class="card-actions">
          <a href="/list/@list.Id" class="icon-button icon-view" title="View Details">
   <i class="fas fa-eye"></i>
   </a>
     <a href="/listbuilder/@list.Id" class="icon-button icon-edit" title="Edit List">
  <i class="fas fa-edit"></i>
             </a>
          <button class="icon-button icon-delete" @onclick="() => DeleteList(list.Id)" title="Delete List">
   <i class="fas fa-trash"></i>
     </button>
        </div>
     </div>
}
  </div>
    }
</div>

@code {
  private List<UserList>? userLists;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
  {
      await LoadLists();
    }

private async Task LoadLists()
    {
        try
        {
          isLoading = true;
            userLists = await ListStorageService.GetAllListsAsync();
        }
   catch (Exception ex)
        {
            Console.WriteLine($"Error loading lists: {ex.Message}");
    userLists = new();
        }
finally
        {
  isLoading = false;
        }
    }

    private async Task DeleteList(string listId)
    {
        try
{
       await ListStorageService.DeleteListAsync(listId);
    await LoadLists();
        }
        catch (Exception ex)
        {
     Console.WriteLine($"Error deleting list: {ex.Message}");
        }
    }
}
