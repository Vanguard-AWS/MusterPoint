@page "/login"
@using MusterPoint.Client.Models.Authentication
@using MusterPoint.Client.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<PageTitle>Login - MusterPoint</PageTitle>

@if (isCheckingAuth)
{
    <div class="terminal-container loading-screen">
        <div class="scanlines"></div>
     <div class="terminal-content">
            <p class="terminal-text">[INITIALIZING SYSTEM...]</p>
  <div class="loading-spinner-terminal"></div>
            <p class="terminal-text">[AUTHENTICATING CREDENTIALS...]</p>
        </div>
    </div>
}
else
{
    <div class="terminal-container">
        <div class="scanlines"></div>
        <div class="terminal-content login-content">
          <div class="ascii-header">
            <h1 class="title-main">ACCESS TERMINAL</h1>
     <p class="title-sub">User Authentication Required</p>
   </div>

       @if (!string.IsNullOrEmpty(errorMessage))
    {
          <div class="terminal-alert alert-danger">
       <p class="terminal-text">
          <span class="alert-icon">?</span> @errorMessage
         </p>
  </div>
   }

        <form @onsubmit="HandleLogin">
         <div class="terminal-section form-group">
            <label class="terminal-text terminal-prompt">> USERNAME</label>
           <input type="text" class="terminal-input" id="username" @bind="username" required placeholder="Enter your username" />
  </div>

    <div class="terminal-section form-group">
                    <label class="terminal-text terminal-prompt">> PASSWORD</label>
  <input type="password" class="terminal-input" id="password" @bind="password" required placeholder="Enter your password" />
      </div>

         <div class="terminal-section button-group">
           <button type="submit" class="terminal-button terminal-button-primary" disabled="@isLoading">
               <span class="button-bracket">[</span>
         <span class="button-text">
     @if (isLoading)
         {
          <span>AUTHENTICATING...</span>
            }
            else
       {
      <span>SIGN IN</span>
     }
      </span>
      <span class="button-bracket">]</span>
       </button>
                </div>
     </form>

            <div class="terminal-section footer">
             <p class="terminal-text terminal-dim">
         > No account? <a href="/register" class="terminal-link">CREATE NEW PROFILE</a>
   </p>
            </div>
   </div>
    </div>
}

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isCheckingAuth = true;

    protected override async Task OnInitializedAsync()
    {
        isCheckingAuth = true;
  try
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
   if (isAuthenticated)
       {
        NavigationManager.NavigateTo("/lists", replace: true);
                return;
            }
        }
        catch (Exception ex)
        {
          errorMessage = $"Error checking authentication: {ex.Message}";
        }
        finally
        {
    isCheckingAuth = false;
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
     {
   errorMessage = "Username and password are required";
            return;
        }

        isLoading = true;

        try
     {
     var response = await AuthService.LoginAsync(username, password);

            if (response.Success)
            {
     NavigationManager.NavigateTo("/lists");
            }
            else
       {
    errorMessage = response.Message;
     }
        }
        catch (Exception ex)
     {
       errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
    isLoading = false;
        }
    }
}
